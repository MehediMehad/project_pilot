model User {
  id       String     @id @default(uuid())
  image    String?
  name     String
  email    String     @unique
  password String
  role     UserRole   @default(TEAM_MEMBER)
  status   UserStatus @default(ACTIVE)

  // Relations
  createdProjects Project[] @relation("CreatedProjects")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
