model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  deadline    DateTime
  status      ProjectStatus @default(ACTIVE)

  createdById String
  createdBy   User   @relation("CreatedProjects", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
